# PulseLab Forge — primary configuration file.
# Edit Pulse_cfg.json for LLM, RAG, MCP, PCB, and schematic settings.
# Optional .env overrides (see knowledge/pulse_config.py _ENV_TO_CFG map).

PULSE_OLLAMA_BASE_URL=http://localhost:11431/v1
PULSE_LLM_MODEL=qwythos-9b-96k
PULSE_EMBED_MODEL=nomic-embed-text
PULSE_LLM_TIMEOUT=900
PULSE_LLM_MAX_TOKENS=16384
PULSE_LLM_NUM_PREDICT=16384
PULSE_LLM_NUM_CTX=98304
